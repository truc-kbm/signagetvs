MANAGE_PIN=4321
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
STORAGE_DRIVER=local
# Local data defaults to .signage-data in this project.
# SIGNAGE_DATA_DIR=/absolute/path/to/persistent/data
# Vercel: use STORAGE_DRIVER=blob and both tokens below.
# Private Blob store for settings; public Blob store for menu images.
CONFIG_BLOB_READ_WRITE_TOKEN=
MEDIA_BLOB_READ_WRITE_TOKEN=
